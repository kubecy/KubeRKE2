#!/bin/bash
## ============================================================
## rke2ctl - RKE2 多环境部署管理工具
## 用法:
##   rke2ctl new <环境名>                             创建新部署环境(自动加密 secrets)
##   rke2ctl setup <环境名> <rke2-server|rke2-agent>  部署 k8s-master 或 k8s-work
##   rke2ctl help                                     显示帮助
## 说明: 脚本自动 cd 到仓库根目录, 任意目录下均可执行
## ============================================================

# ---------- 1. 定位仓库根目录 (兼容软链调用) ----------
SOURCE="${BASH_SOURCE[0]}"
while [ -h "${SOURCE}" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
done
REPO_ROOT="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
cd "${REPO_ROOT}" || { echo "错误: 无法进入仓库目录 ${REPO_ROOT}" >&2; exit 1; }
INVENTORY_DIR="${REPO_ROOT}/inventory"

# ---------- 2. 公共函数 ----------
err()  { echo "错误: $*" >&2; }
info() { echo "信息: $*"; }

usage() {
  cat <<EOF
用法:
  rke2ctl new <环境名>                             创建新部署环境(自动加密 secrets)
  rke2ctl setup <环境名> <rke2-server|rke2-agent>  部署 k8s-master 或 k8s-work
  rke2ctl help                                     显示本帮助

示例:
  rke2ctl new zxjt-k99
  rke2ctl setup zxjt-k99 rke2-server
  rke2ctl setup zxjt-k99 rke2-agent
EOF
}

valid_env_name() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]; }

# ---------- 3. new: 创建新环境 ----------
cmd_new() {
  [ "$#" -eq 1 ] || { err "new 需要 1 个参数: 环境名"; usage >&2; exit 2; }
  local env_name="$1"

  if ! valid_env_name "${env_name}"; then
    err "非法环境名: ${env_name} (仅允许字母/数字/下划线/连字符)"
    exit 2
  fi

  local env_dir="${INVENTORY_DIR}/${env_name}"
  if [ -e "${env_dir}" ]; then
    err "环境 ${env_name} 已存在: ${env_dir}"
    exit 2
  fi
  if [ ! -d "${INVENTORY_DIR}/sample" ]; then
    err "找不到模板目录 inventory/sample"
    exit 1
  fi
  command -v ansible-vault >/dev/null 2>&1 || {
    err "未找到 ansible-vault, 请先安装 ansible"
    exit 1
  }

  # 工具校验已通过, 再创建目录, 失败不留残留
  cp -r "${INVENTORY_DIR}/sample" "${env_dir}" || { err "复制模板失败"; exit 1; }
  info "已创建环境 ${env_name}: ${env_dir}"

  info "正在加密 ${env_dir}/secrets.yml (请输入两遍 vault 密码)"
  if ! ansible-vault encrypt "${env_dir}/secrets.yml"; then
    err "secrets.yml 加密失败, 回滚删除环境 ${env_name}"
    err "如需保留可手动补加密: ansible-vault encrypt ${env_dir}/secrets.yml"
    rm -rf "${env_dir}"
    exit 1
  fi
  info "secrets.yml 加密成功"

  cat <<EOF
============================================================
环境 ${env_name} 创建完成, 后续步骤:
  1. vim ${env_dir}/hosts         修改主机清单(组 rke2_server/rke2_agent, 仅一台 init_master=true)
  2. vim ${env_dir}/site.yml      修改环境变量(IP/token/harbor/密码)
  3. ansible-vault edit ${env_dir}/secrets.yml   填入各主机 sudo 密码(base64)
  4. bash ${env_dir}/ssh-copy.sh  分发 SSH 公钥
  5. rke2ctl setup ${env_name} rke2-server   部署 k8s-master
     rke2ctl setup ${env_name} rke2-agent    部署 k8s-work
============================================================
EOF
}

# ---------- 4. setup: 部署 ----------
cmd_setup() {
  [ "$#" -eq 2 ] || { err "setup 需要 2 个参数: 环境名 与 部署类型"; usage >&2; exit 2; }
  local env_name="$1" node_type="$2"

  case "${node_type}" in
    rke2-server|rke2-agent) ;;
    *) err "无效的部署类型: ${node_type}, 可选值: rke2-server / rke2-agent"; exit 2 ;;
  esac

  if ! valid_env_name "${env_name}"; then
    err "非法环境名: ${env_name} (仅允许字母/数字/下划线/连字符)"
    exit 2
  fi

  local env_dir="${INVENTORY_DIR}/${env_name}"
  if [ ! -d "${env_dir}" ]; then
    err "环境 ${env_name} 不存在, 请先执行: rke2ctl new ${env_name}"
    exit 2
  fi
  [ -f "${env_dir}/hosts" ] || { err "缺少 ${env_dir}/hosts, 请先修改 hosts"; exit 1; }
  [ -f "${env_dir}/secrets.yml" ] || { err "缺少 ${env_dir}/secrets.yml, 请先加密并填入 sudo 密码"; exit 1; }

  command -v ansible-playbook >/dev/null 2>&1 || {
    err "未找到 ansible-playbook, 请先安装 ansible"
    exit 1
  }

  info "开始部署: ${env_name} (${node_type})"
  info "执行: ansible-playbook -i inventory/${env_name}/hosts --ask-vault-pass playbooks/${node_type}.yml"

  ansible-playbook -i "inventory/${env_name}/hosts" \
                   --ask-vault-pass "playbooks/${node_type}.yml"
  local rc=$?
  if [ "${rc}" -eq 0 ]; then
    info "部署完成 (退出码 0)"
  else
    err "部署失败 (退出码 ${rc}: 1=执行错误 2=主机不可达 3=解析错误 99=中断)"
  fi
  exit "${rc}"
}

# ---------- 5. 命令分发 ----------
main() {
  local cmd="${1:-}"
  case "${cmd}" in
    new)          shift; cmd_new "$@" ;;
    setup)        shift; cmd_setup "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    "")           err "缺少命令"; usage >&2; exit 2 ;;
    *)            err "未知命令: ${cmd}"; usage >&2; exit 2 ;;
  esac
}
main "$@"
