#!/bin/bash

logger() {
  local timestamp=$(date +'%Y-%m-%d %H:%M:%S')
  local caller_file=$(basename "${BASH_SOURCE[1]}")
  local caller_prefix="\033[35m[${caller_file}:${BASH_LINENO[0]}]\033[0m"
  local message="${*:2}"
  case "$1" in
    debug)
      echo -e "\033[35m${timestamp}\033[0m ${caller_prefix} \033[36mDEBUG \033[0m${message}"
      ;;
    info)
      echo -e "\033[35m${timestamp}\033[0m ${caller_prefix} \033[32mINFO  \033[0m${message}"
      ;;
    warn)
      echo -e "\033[35m${timestamp}\033[0m ${caller_prefix} \033[33mWARN  \033[0m${message}"
      ;;
    error)
      echo -e "\033[35m${timestamp}\033[0m ${caller_prefix} \033[31mERROR \033[0m${message}"
      ;;
    *) ;;
  esac
}

script_path="${BASH_SOURCE[0]}"
while [[ -h "${script_path}" ]]; do
  script_dir="$(cd -P "$(dirname "${script_path}")" && pwd)"
  script_path="$(readlink "${script_path}")"
  [[ "${script_path}" != /* ]] && script_path="${script_dir}/${script_path}"
done
REPO_ROOT="$(cd -P "$(dirname "${script_path}")" && pwd)"
cd "${REPO_ROOT}" || { logger error "无法进入仓库目录 ${REPO_ROOT}"; exit 1; }
INVENTORY_DIR="${REPO_ROOT}/inventory"

valid_env_name() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]; }

require_cmd() {
  local cmd_name="$1" install_hint="$2"
  command -v "${cmd_name}" >/dev/null 2>&1 || {
    logger error "未找到 ${cmd_name}, ${install_hint}"
    exit 1
  }
}

require_valid_env() {
  local env_name="$1"
  if ! valid_env_name "${env_name}"; then
    logger error "非法环境名: ${env_name} (仅允许字母/数字/下划线/连字符)"
    exit 2
  fi
}

site_get_field() {
  local site_file="$1" key_prefix="$2" out_var="$3" value
  value="$(sed -n "s/${key_prefix}:[[:space:]]*[\"']\{0,1\}\([^\"'[:space:]]*\).*/\1/p" \
      "${site_file}" | head -n 1)"
  printf -v "${out_var}" '%s' "${value}"
}

site_get_proxy() {
  local site_file="$1" out_var="$2" value
  value="$(sed -n "s/^download_proxy:[[:space:]]*[\"']\{0,1\}\([^\"']*\).*/\1/p" \
      "${site_file}" | head -n 1 | sed 's/[[:space:]]*##.*//')"
  printf -v "${out_var}" '%s' "${value}"
}

resolve_arch() {
  local arch_raw="$1" arch_linux_var="$2" arch_short_var="$3"
  case "${arch_raw}" in
    amd|amd64)
      printf -v "${arch_linux_var}" '%s' 'linux-amd64'
      printf -v "${arch_short_var}" '%s' 'amd64'
      ;;
    arm|arm64)
      printf -v "${arch_linux_var}" '%s' 'linux-arm64'
      printf -v "${arch_short_var}" '%s' 'arm64'
      ;;
    *)
      logger error "site.yml 中 arch 配置非法: ${arch_raw:-空} (可选: amd/amd64/arm/arm64)"
      exit 2
      ;;
  esac
}

read_docker_repo() {
  local site_file="$1" host_var="$2" user_var="$3" pass_var="$4"
  local host_val="" user_val="" pass_val="" line in_repo=0
  local re_key="^[[:space:]]{2}[A-Za-z_][A-Za-z0-9_]*:"
  local re_host="^[[:space:]]{4}host:[[:space:]]*[\"']?([^\"'[:space:]]+)[\"']?"
  local re_user="^[[:space:]]{4}user:[[:space:]]*[\"']?([^\"'[:space:]]+)[\"']?"
  local re_pass="^[[:space:]]{4}password:[[:space:]]*[\"']?([^\"'[:space:]]+)[\"']?"
  while IFS= read -r line; do
    if [[ "${line}" =~ ${re_key} ]]; then in_repo=0; fi
    if [[ "${line}" =~ ^[[:space:]]{2}docker_repo:[[:space:]]*$ ]]; then in_repo=1; continue; fi
    if [[ "${in_repo}" -eq 1 ]]; then
      [[ "${line}" =~ ${re_host} ]] && host_val="${BASH_REMATCH[1]}"
      [[ "${line}" =~ ${re_user} ]] && user_val="${BASH_REMATCH[1]}"
      [[ "${line}" =~ ${re_pass} ]] && pass_val="${BASH_REMATCH[1]}"
    fi
  done < "${site_file}"
  printf -v "${host_var}" '%s' "${host_val}"
  printf -v "${user_var}" '%s' "${user_val}"
  printf -v "${pass_var}" '%s' "${pass_val}"
}

parse_hosts() {
  local hosts_file="$1"
  awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*\[/ {
      role = ($0 ~ /rke2_server/) ? "master" \
        : (($0 ~ /rke2_agent/) ? "worker" : "")
      next
    }
    role != "" && match($0, /ansible_host=[0-9.]+/) {
      ansible_ip = substr($0, RSTART + 13, RLENGTH - 13)
      if (!seen[role, ansible_ip]++) { print role, $1, ansible_ip }
    }
  ' "${hosts_file}"
}

vault_view() {
  local secrets_file="$1"
  ansible-vault view "${secrets_file}" 2>/dev/null
}

verify_checksums() {
  local checksum_file="$1" target_dir="$2" arch_linux="$3"
  shift 3
  local -a files=("$@")
  local expected actual failed=0 file
  for file in "${files[@]}"; do
    if [[ "${file}" == "rke2-images-all.${arch_linux}.txt" ]]; then
      expected=""
    else
      expected="$(grep -F "  ${file}" "${checksum_file}" | head -n 1 | awk '{print $1}')"
    fi
    if [[ -z "${expected}" ]]; then
      if [[ -s "${target_dir}/${file}" ]]; then
        logger info "非空检查通过: ${file}"
      else
        logger error "文件缺失或为空: ${file}"
        failed=1
      fi
      continue
    fi
    actual="$(sha256sum "${target_dir}/${file}" | awk '{print $1}')"
    if [[ "${actual}" == "${expected}" ]]; then
      logger info "校验通过: ${file}"
    else
      logger error "校验失败: ${file} (期望 ${expected}, 实际 ${actual})"
      logger error "请删除后重下: rm -f '${target_dir}/${file}'"
      failed=1
    fi
  done
  return "${failed}"
}
usage() {
  echo -e "\033[33mUsage:\033[0m ./rke2ctl <command> [args]"
  cat <<'EOF'
用法:
  ./rke2ctl help                                             显示本帮助
  ./rke2ctl bash-completion                                  启用 tab 补全
  ./rke2ctl new   <环境名>                                   创建新部署环境, 自动加密 secrets
  ./rke2ctl setup <环境名> <ssh-copy|rke2-server|rke2-agent> 发 SSH 公钥和部署 k8s-master、k8s-work
  ./rke2ctl download <环境名>                               离线下载 RKE2 安装包至 packages_rke2/<环境名>/<版本>/<架构>/, rke2_version/arch/cni 均读环境 site.yml
  ./rke2ctl pull <环境名> [registry]                        离线镜像一键导入私有仓库: 去 docker.io/ 前缀、docker login、加载全部 rke2-images*.tar.gz, registry 缺省取 site.yml global.docker_repo.host

示例:
  ./rke2ctl new cq-moone-k45                                      创建部署环境
  ./rke2ctl download cq-moone-k45                                 按 cq-moone-k45 的 rke2_version/arch/cni 配置下载
  ./rke2ctl setup cq-moone-k45 ssh-copy                           分发公钥
  ./rke2ctl setup cq-moone-k45 rke2-server                        部署 k8s-master
  ./rke2ctl setup cq-moone-k45 rke2-agent                         部署 k8s-worker

EOF
}

cmd_new() {
  [[ $# -eq 1 ]] || {
    logger error "new 需要 1 个参数: 环境名"
    usage >&2
    exit 2
  }
  local env_name="$1"

  require_valid_env "${env_name}"

  local env_dir="${INVENTORY_DIR}/${env_name}"
  if [[ -e "${env_dir}" ]]; then
    logger error "环境 ${env_name} 已存在: ${env_dir}"
    exit 2
  fi
  if [[ ! -d "${INVENTORY_DIR}/sample" ]]; then
    logger error "找不到模板目录 inventory/sample"
    exit 1
  fi
  require_cmd ansible-vault "请先安装 ansible"

  cp -r "${INVENTORY_DIR}/sample" "${env_dir}" || { logger error "复制模板失败"; exit 1; }
  logger info "已创建环境 ${env_name}: ${env_dir}"

  logger info "正在加密 ${env_dir}/secrets.yml (请输入两遍 vault 密码)"
  if ! ansible-vault encrypt "${env_dir}/secrets.yml"; then
    logger error "secrets.yml 加密失败, 回滚删除环境 ${env_name}"
    logger error "如需保留可手动补加密: ansible-vault encrypt ${env_dir}/secrets.yml"
    rm -rf "${env_dir}"
    exit 1
  fi
  logger info "secrets.yml 加密成功"

  cat <<EOF
============================================================
环境 ${env_name} 创建完成, 后续步骤:
  1. vim ${env_dir}/hosts                       配置主机清单
  2. vim ${env_dir}/site.yml                    修改环境变量
  3. ansible-vault edit ${env_dir}/secrets.yml  填入各主机 sudo 密码(base64)
  4. ./rke2ctl setup ${env_name} ssh-copy       自动分发 SSH 公钥
  5. ./rke2ctl setup ${env_name} rke2-server    部署 k8s-master
  6. ./rke2ctl setup ${env_name} rke2-agent     部署 k8s-work
============================================================
EOF
}

cmd_setup() {
  [[ $# -eq 2 ]] || {
    logger error "setup 需要 2 个参数: 环境名 与 部署类型"
    usage >&2
    exit 2
  }
  local env_name="$1" node_type="$2"

  case "${node_type}" in
    rke2-server|rke2-agent|ssh-copy) ;;
    *)
      logger error "无效的部署类型: ${node_type}, 可选值:"\
        "rke2-server / rke2-agent / ssh-copy"
      exit 2
      ;;
  esac

  require_valid_env "${env_name}"

  local env_dir="${INVENTORY_DIR}/${env_name}"
  if [[ ! -d "${env_dir}" ]]; then
    logger error "环境 ${env_name} 不存在, 请先执行: ./rke2ctl new ${env_name}"
    exit 2
  fi
  [[ -f "${env_dir}/hosts" ]] || {
    logger error "缺少 ${env_dir}/hosts, 请先修改 hosts"
    exit 1
  }

  if [[ "${node_type}" == "ssh-copy" ]]; then
    cmd_ssh_copy "${env_dir}"
    exit
  fi

  [[ -f "${env_dir}/secrets.yml" ]] || {
    logger error "缺少 ${env_dir}/secrets.yml, 请先加密并填入 sudo 密码"
    exit 1
  }

  require_cmd ansible-playbook "请先安装 ansible"

  logger info "开始部署: ${env_name} (${node_type})"
  logger info "执行: ansible-playbook -i inventory/${env_name}/hosts"\
    "--ask-vault-pass -e env_dir=${env_dir} playbooks/${node_type}.yml"

  ansible-playbook -i "inventory/${env_name}/hosts" \
      --ask-vault-pass -e "env_dir=${env_dir}" "playbooks/${node_type}.yml"
  local rc=$?
  if [[ "${rc}" -eq 0 ]]; then
    logger info "部署完成 (退出码 0)"
  else
    logger error "部署失败 (退出码 ${rc}: 1=执行错误 2=主机不可达"\
      "3=解析错误 99=中断)"
  fi
  exit "${rc}"
}

cmd_ssh_copy() {
  local env_dir="$1"
  local hosts_file="${env_dir}/hosts"
  local site_file="${env_dir}/site.yml"

  require_cmd sshpass "请先安装 (如: yum install -y sshpass)"

  local ssh_user
  ssh_user="$(sed -n 's/^ssh_user:[[:space:]]*\([^ #]*\).*/\1/p' "${site_file}" | head -n 1)"
  if [[ -z "${ssh_user}" ]]; then
    ssh_user="admin"
  fi

  local master_ips=() worker_ips=() master_hosts=() worker_hosts=() group host ip
  while read -r group host ip; do
    case "${group}" in
      master) master_ips+=("${ip}"); master_hosts+=("${host}") ;;
      worker) worker_ips+=("${ip}"); worker_hosts+=("${host}") ;;
    esac
  done < <(parse_hosts "${hosts_file}")

  local total=$(( ${#master_ips[@]} + ${#worker_ips[@]} ))
  if [[ "${total}" -eq 0 ]]; then
    logger error "未在 ${hosts_file} 中解析到任何主机"
    exit 1
  fi
  logger info "SSH 用户: ${ssh_user}"
  if [[ ${#master_ips[@]} -gt 0 ]]; then
    logger info "向 ${#master_ips[@]} 台 master 主机分发公钥: "
    for ip in "${master_ips[@]}"; do
      echo "${ip} "
    done
  fi
  if [[ ${#worker_ips[@]} -gt 0 ]]; then
    logger info "向 ${#worker_ips[@]} 台 worker 主机分发公钥: "
    for ip in "${worker_ips[@]}"; do
      echo "${ip} "
    done
  fi

  if [[ ! -f ~/.ssh/id_rsa.pub ]]; then
    logger info "未检测到 SSH 公钥, 自动生成..."
    ssh-keygen -t rsa -b 4096 -N "" -f ~/.ssh/id_rsa || {
      logger error "SSH 密钥生成失败"
      exit 1
    }
  fi
  chmod 600 ~/.ssh/id_rsa 2>/dev/null
  chmod 644 ~/.ssh/id_rsa.pub 2>/dev/null

  local secrets_file="${env_dir}/secrets.yml"
  if [[ ! -f "${secrets_file}" ]]; then
    logger error "缺少 ${secrets_file}, 请先创建并加密"\
      "(参考 inventory/sample/secrets.yml)"
    exit 1
  fi
  require_cmd ansible-vault "请先安装 ansible"
  logger info "正在解密 ${secrets_file} (请输入 vault 密码)"
  local vault_text
  vault_text="$(vault_view "${secrets_file}")" || {
    logger error "secrets.yml 解密失败, 请检查 vault 密码"
    exit 1
  }

  local -A host_pass_b64=()
  local cur_host="" line
  local re_host="^[[:space:]]{2}[A-Za-z0-9_.-]+:[[:space:]]*$"
  local re_sudopass="^[[:space:]]{4}sudopass:[[:space:]]*[\"']?([^\"'[:space:]]+)[\"']?"
  while IFS= read -r line; do
    if [[ "${line}" =~ ${re_host} ]]; then
      cur_host="${line//[[:space:]]/}"
      cur_host="${cur_host%:}"
    elif [[ -n "${cur_host}" && "${line}" =~ ${re_sudopass} ]]; then
      host_pass_b64["${cur_host}"]="${BASH_REMATCH[1]}"
    fi
  done <<< "${vault_text}"

  local failed=0 ip padded_ip
  local -a group_ips group_hosts
  for group in master worker; do
    if [[ "${group}" == "master" ]]; then
      group_ips=("${master_ips[@]}")
      group_hosts=("${master_hosts[@]}")
    else
      group_ips=("${worker_ips[@]}")
      group_hosts=("${worker_hosts[@]}")
    fi
    for i in "${!group_ips[@]}"; do
      ip="${group_ips[i]}"
      local host="${group_hosts[i]}"
      local password_b64="${host_pass_b64[${host}]}"
      if [[ -z "${password_b64}" ]]; then
        logger error "secrets.yml 中缺少主机 ${host} 的 sudopass"
        failed=1
        continue
      fi
      local password
      password="$(printf '%s' "${password_b64}" | base64 -d)"
      printf -v padded_ip '%-15s' "${ip}"
      if sshpass -p "${password}" ssh-copy-id \
          -o StrictHostKeyChecking=accept-new \
          -o ConnectTimeout=10 \
          -o ServerAliveInterval=5 \
          -o ServerAliveCountMax=3 \
          -o PasswordAuthentication=yes \
          "${ssh_user}@${ip}" >/dev/null 2>&1; then
        logger info "分发到 ${group}：${host} ${padded_ip} 分发成功"
      else
        logger error "分发到 ${group}：${host} ${padded_ip} 分发失败"
        failed=1
      fi
    done
  done
  unset password
  if [[ "${failed}" -eq 0 ]]; then
    logger info "全部主机分发完成"
  else
    logger error "存在分发失败的主机 (退出码 ${failed})"
  fi
  exit "${failed}"
}

cmd_install_completion() {
  local bashrc="${HOME}/.bashrc"
  local comp_file="${HOME}/.rke2ctl.bash"

  local func_body
  func_body="$(cat <<'EOF'

_rke2ctl_envs() {
  local d name
  local -a envs=()
  for d in "__RKE2_REPO_ROOT__"/inventory/*/; do
    [[ -d "${d}" ]] || continue
    name="$(basename "${d}")"
    [[ "${name}" == "sample" ]] && continue
    envs+=("${name}")
  done
  printf '%s\n' "${envs[@]}"
}

_rke2ctl() {
  local cur
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"

  if [[ "${COMP_CWORD}" -eq 1 ]]; then
    mapfile -t COMPREPLY < <(compgen -W "new setup download pull help bash-completion" -- "${cur}")
    return 0
  fi

  case "${COMP_WORDS[1]}" in
    new)
      ;;
    download|pull|setup)
      if [[ "${COMP_CWORD}" -eq 2 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$(_rke2ctl_envs)" -- "${cur}")
      elif [[ "${COMP_WORDS[1]}" == "setup" && "${COMP_CWORD}" -eq 3 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "rke2-server rke2-agent ssh-copy" -- "${cur}")
      fi
      ;;
  esac
}
complete -F _rke2ctl ./rke2ctl rke2ctl
EOF
)"
  func_body="${func_body//__RKE2_REPO_ROOT__/${REPO_ROOT}}"

  printf '%s\n' "${func_body}" > "${comp_file}" || {
    logger error "写入 ${comp_file} 失败"
    exit 1
  }
  logger info "Tab 补全脚本已写入   ${comp_file}"

  if [[ -f "${bashrc}" ]]; then
    grep -vF ".rke2ctl.bash" "${bashrc}" \
      | grep -vF "rke2ctl_completion.sh" \
      | grep -vF "complete -F _rke2ctl" \
      | grep -vF "# rke2ctl tab 补全" \
      | awk 'NF==0 && wasblank { next } { wasblank=(NF==0); print }' \
      > "${bashrc}.new"
    sed -i ':a; /^\n*$/{ $d; N; ba }' "${bashrc}.new"
    mv "${bashrc}.new" "${bashrc}"
  fi

  printf '\n# rke2ctl tab 补全 (bash-completion)\nsource ~/.rke2ctl.bash\n' >> "${bashrc}" \
      || { logger error "写入 ${bashrc} 失败"; exit 1; }
  logger info "已写入 ${bashrc}"
  logger info "执行命令加载: source ${bashrc}"
  echo " "
}

cmd_download() {
  [[ $# -eq 1 ]] || {
    logger error "download 需要 1 个参数: 环境名"
    usage >&2
    exit 2
  }
  local env_name="$1"
  local version arch_raw cni
  local arch_linux arch_short version_urlsafe dest_dir site_file download_proxy

  require_valid_env "${env_name}"
  site_file="${INVENTORY_DIR}/${env_name}/site.yml"
  [[ -f "${site_file}" ]] || {
    logger error "找不到 ${site_file}, 请先 ./rke2ctl new ${env_name} 或指定已有环境名"
    exit 1
  }

  site_get_field "${site_file}" '^rke2_version' version
  site_get_field "${site_file}" '^arch' arch_raw
  arch_raw="$(printf '%s' "${arch_raw}" | tr 'A-Z' 'a-z')"
  site_get_proxy "${site_file}" download_proxy
  site_get_field "${site_file}" '^[[:space:]]*cni' cni
  cni="$(printf '%s' "${cni}" | tr 'A-Z' 'a-z')"
  logger info "环境 ${env_name} 配置:"\
    "rke2_version=${version:-空} arch=${arch_raw:-空} cni=${cni:-none}"

  if ! [[ "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+\+rke2r[0-9]+(\.[0-9a-zA-Z]+)*$ ]]; then
    logger error "site.yml 中缺少合法的 rke2_version:"\
      "${version:-空} (示例: v1.34.6+rke2r3)"
    exit 2
  fi
  version_urlsafe="${version//+/%2B}"

  resolve_arch "${arch_raw}" arch_linux arch_short

  dest_dir="${REPO_ROOT}/packages_rke2/${env_name}/${version}/${arch_short}"
  mkdir -p "${dest_dir}" || { logger error "创建目录失败: ${dest_dir}"; exit 1; }

  local -a files=(
    "install.sh"
    "rancher-load-images.sh"
    "rke2.${arch_linux}.tar.gz"
    "sha256sum-${arch_short}.txt"
    "rke2-images-all.${arch_linux}.txt"
    "rke2-images.${arch_linux}.tar.gz"
  )
  case "${cni}" in
    *cilium*) files+=("rke2-images-cilium.${arch_linux}.tar.gz") ;;
    *canal*)  files+=("rke2-images-canal.${arch_linux}.tar.gz")  ;;
    *calico*) files+=("rke2-images-calico.${arch_linux}.tar.gz") ;;
  esac

  local -a github_mirrors=()
  read -r -a github_mirrors <<< "${download_proxy}"
  local file url github_path fetch_ok
  local -a urls
  for file in "${files[@]}"; do
    github_path=""
    case "${file}" in
      install.sh)
        url="https://get.rke2.io" ;;
      rancher-load-images.sh)
        github_path="rancher/rancher/releases/download/v2.15.0/rancher-load-images.sh" ;;
      *)
        github_path="rancher/rke2/releases/download/${version_urlsafe}/${file}" ;;
    esac

    if [[ -s "${dest_dir}/${file}" ]]; then
      logger info "已存在, 跳过下载: ${file}"
      continue
    fi

    urls=()
    if [[ -n "${github_path}" ]]; then
      for mirror in "${github_mirrors[@]}"; do
        urls+=("${mirror}https://github.com/${github_path}")
      done
      urls+=("https://github.com/${github_path}")
    else
      urls+=("${url}")
    fi

    fetch_ok=0
    for mirror_url in "${urls[@]}"; do
      logger info "正在下载: ${file} <- ${mirror_url}"
      if curl -fL --connect-timeout 10 --retry 2 --retry-delay 2 --retry-all-errors \
          -o "${dest_dir}/${file}" "${mirror_url}"; then
        fetch_ok=1
        break
      fi
      rm -f "${dest_dir}/${file}"
    done
    if [[ "${fetch_ok}" -ne 1 ]]; then
      logger error "下载失败: ${file} (全部加速镜像及官方直连均失败)"
      exit 1
    fi
  done

  local checksum_file="${dest_dir}/sha256sum-${arch_short}.txt"
  [[ -f "${checksum_file}" ]] || { logger error "缺少校验文件 ${checksum_file}"; exit 1; }
  local failed=0
  verify_checksums "${checksum_file}" "${dest_dir}" "${arch_linux}" "${files[@]}"
  failed=$?

  if [[ "${failed}" -eq 0 ]]; then
    logger info "全部下载完成并校验通过: ${dest_dir}"
  else
    logger error "存在失败项, 修复后重跑: ./rke2ctl download ${env_name}"
    exit 1
  fi
}

cmd_pull() {
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    logger error "pull 需要 1-2 个参数: 环境名 [registry]"
    usage >&2
    exit 2
  fi
  local env_name="$1" registry_override="${2:-}"

  require_valid_env "${env_name}"
  local site_file="${INVENTORY_DIR}/${env_name}/site.yml"
  [[ -f "${site_file}" ]] || {
    logger error "找不到 ${site_file}, 请先 ./rke2ctl new ${env_name}"
    exit 2
  }

  local version arch_raw arch_linux arch_short
  site_get_field "${site_file}" '^rke2_version' version
  site_get_field "${site_file}" '^arch' arch_raw
  arch_raw="$(printf '%s' "${arch_raw}" | tr 'A-Z' 'a-z')"
  resolve_arch "${arch_raw}" arch_linux arch_short

  local repo_host repo_user repo_pass
  read_docker_repo "${site_file}" repo_host repo_user repo_pass

  local registry="${registry_override:-${repo_host}}"
  if [[ -z "${registry}" ]]; then
    logger error "site.yml 未配置 global.docker_repo.host, 请手动指定:"\
      "./rke2ctl pull ${env_name} <registry>"
    exit 2
  fi
  [[ -n "${repo_user}" ]] || {
    logger error "site.yml 未配置 global.docker_repo.user, 无法 docker login"
    exit 2
  }

  local dest_dir="${REPO_ROOT}/packages_rke2/${env_name}/${version}/${arch_short}"
  [[ -d "${dest_dir}" ]] || {
    logger error "找不到离线包目录: ${dest_dir}"
    logger error "请先下载: ./rke2ctl download ${env_name}"
    exit 1
  }

  local image_list_file="${dest_dir}/rke2-images-all.${arch_linux}.txt"
  local loader="${dest_dir}/rancher-load-images.sh"
  [[ -f "${image_list_file}" ]] || {
    logger error "缺少镜像清单: ${image_list_file}"
    exit 1
  }
  [[ -f "${loader}" ]] || {
    logger error "缺少 ${loader}, 请重跑 ./rke2ctl download ${env_name}"
    exit 1
  }

  local -a tarballs=()
  local tarball
  for tarball in "${dest_dir}"/rke2-images*.tar.gz; do
    [[ -e "${tarball}" ]] || continue
    tarballs+=("${tarball}")
  done
  [[ ${#tarballs[@]} -gt 0 ]] || {
    logger error "未找到镜像包 rke2-images*.tar.gz: ${dest_dir}"
    exit 1
  }

  local sudo_cmd=""
  if [[ "$(id -u)" -ne 0 ]] && ! docker info >/dev/null 2>&1; then
    command -v sudo >/dev/null 2>&1 || {
      logger error "当前用户无 docker 权限且未安装 sudo"
      exit 1
    }
    sudo_cmd="sudo"
  fi

  sed -i 's#docker.io/##g' "${image_list_file}"
  logger info "去除镜像清单 registry 前缀 (docker.io/): ${image_list_file}"

  logger info "登录私有仓库: ${registry} (用户 ${repo_user})"
  if ! printf '%s\n' "${repo_pass}" | ${sudo_cmd} docker login "${registry}" \
      -u "${repo_user}" --password-stdin >/dev/null 2>&1; then
    logger error "docker login 失败: ${registry},"\
      "请检查 site.yml 的 global.docker_repo.user/password"
    exit 1
  fi
  logger info "登录成功: ${registry}"

  local failed=0
  for tarball in "${tarballs[@]}"; do
    logger info "加载镜像包: $(basename "${tarball}") -> ${registry}"
    if ( cd "${dest_dir}" && ${sudo_cmd} bash rancher-load-images.sh \
        -l "rke2-images-all.${arch_linux}.txt" -i "$(basename "${tarball}")" \
        -r "${registry}" ); then
      logger info "加载完成: $(basename "${tarball}")"
    else
      logger error "加载失败: $(basename "${tarball}")"
      failed=1
    fi
  done

  if [[ "${failed}" -eq 0 ]]; then
    logger info "全部镜像包加载完成: ${registry}"
  else
    logger error "存在加载失败的镜像包 (退出码 ${failed})"
  fi
  exit "${failed}"
}

main() {
  local cmd="${1:-}"
  if [[ -z "${cmd}" ]]; then
    logger warn "缺少命令, 可参考以下步骤:"
    usage
    exit 0
  fi
  case "${cmd}" in
    new)          shift; cmd_new "$@" ;;
    setup)        shift; cmd_setup "$@" ;;
    d|download)   shift; cmd_download "$@" ;;
    p|pull)       shift; cmd_pull "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    bash-completion) shift; cmd_install_completion "$@" ;;
    *)
      usage
      exit 0
      ;;
  esac
}
main "$@"
