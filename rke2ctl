#!/bin/bash
## ============================================================
## rke2ctl RKE2 多环境部署管理工具                          ###   
## ============================================================

logger() {
  TIMESTAMP=$(date +'%Y-%m-%d %H:%M:%S')
  local FID=$(basename "${BASH_SOURCE[1]}")
  local SOURCE="\033[35m[$FID:${BASH_LINENO[0]}]\033[0m"
  case "$1" in
    debug)
      echo -e "\033[35m$TIMESTAMP\033[0m $SOURCE \033[36mDEBUG \033[0m$2"
      ;;
    info)
      echo -e "\033[35m$TIMESTAMP\033[0m $SOURCE \033[32mINFO  \033[0m$2"
      ;;
    warn)
      echo -e "\033[35m$TIMESTAMP\033[0m $SOURCE \033[33mWARN  \033[0m$2"
      ;;
    error)
      echo -e "\033[35m$TIMESTAMP\033[0m $SOURCE \033[31mERROR \033[0m$2"
      ;;
    *) ;;
  esac
}

SOURCE="${BASH_SOURCE[0]}"
while [ -h "${SOURCE}" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
done
REPO_ROOT="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
cd "${REPO_ROOT}" || { logger error "无法进入仓库目录 ${REPO_ROOT}"; exit 1; }
INVENTORY_DIR="${REPO_ROOT}/inventory"

usage() {
  echo -e "\033[33mUsage:\033[0m ./rke2ctl <command> [args]"
  cat <<EOF
用法:
  ./rke2ctl help                                             显示本帮助
  ./rke2ctl bash-completion                                  启用 tab 补全
  ./rke2ctl new   <环境名>                                   创建新部署环境, 自动加密 secrets
  ./rke2ctl setup <环境名> <ssh-copy|rke2-server|rke2-agent> 发 SSH 公钥和部署 k8s-master、k8s-work
  ./rke2ctl download <环境名>                               离线下载 RKE2 安装包至 packages_rke2/<环境名>/<版本>/<架构>/, rke2_version/arch/cni 均读环境 site.yml

示例:
  ./rke2ctl new zxjt-k99                                      创建部署环境
  ./rke2ctl setup zxjt-k99 ssh-copy                           分发公钥
  ./rke2ctl setup zxjt-k99 rke2-server                        部署 k8s-master
  ./rke2ctl setup zxjt-k99 rke2-agent                         部署 k8s-worker
  ./rke2ctl download zxjt-k99                                 按 zxjt-k99 的 rke2_version/arch/cni 配置下载
EOF
}

valid_env_name() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]; }

cmd_new() {
  [ "$#" -eq 1 ] || { logger error "new 需要 1 个参数: 环境名"; usage >&2; exit 2; }
  local env_name="$1"

  if ! valid_env_name "${env_name}"; then
    logger error "非法环境名: ${env_name} (仅允许字母/数字/下划线/连字符)"
    exit 2
  fi

  local env_dir="${INVENTORY_DIR}/${env_name}"
  if [ -e "${env_dir}" ]; then
    logger error "环境 ${env_name} 已存在: ${env_dir}"
    exit 2
  fi
  if [ ! -d "${INVENTORY_DIR}/sample" ]; then
    logger error "找不到模板目录 inventory/sample"
    exit 1
  fi
  command -v ansible-vault >/dev/null 2>&1 || {
    logger error "未找到 ansible-vault, 请先安装 ansible"
    exit 1
  }

  cp -r "${INVENTORY_DIR}/sample" "${env_dir}" || { logger error "复制模板失败"; exit 1; }
  logger info "已创建环境 ${env_name}: ${env_dir}"

  logger info "正在加密 ${env_dir}/secrets.yml (请输入两遍 vault 密码)"
  if ! ansible-vault encrypt "${env_dir}/secrets.yml"; then
    logger error "secrets.yml 加密失败, 回滚删除环境 ${env_name}"
    logger error "如需保留可手动补加密: ansible-vault encrypt ${env_dir}/secrets.yml"
    rm -rf "${env_dir}"
    exit 1
  fi
  logger info "secrets.yml 加密成功"

  cat <<EOF
============================================================
环境 ${env_name} 创建完成, 后续步骤:
  1. vim ${env_dir}/hosts                       配置主机清单
  2. vim ${env_dir}/site.yml                    修改环境变量
  3. ansible-vault edit ${env_dir}/secrets.yml  填入各主机 sudo 密码(base64)
  4. ./rke2ctl setup ${env_name} ssh-copy       自动分发 SSH 公钥
  5. ./rke2ctl setup ${env_name} rke2-server    部署 k8s-master
  6. ./rke2ctl setup ${env_name} rke2-agent     部署 k8s-work
============================================================
EOF
}

cmd_setup() {
  [ "$#" -eq 2 ] || { logger error "setup 需要 2 个参数: 环境名 与 部署类型"; usage >&2; exit 2; }
  local env_name="$1" node_type="$2"

  case "${node_type}" in
    rke2-server|rke2-agent|ssh-copy) ;;
    *) logger error "无效的部署类型: ${node_type}, 可选值: rke2-server / rke2-agent / ssh-copy"; exit 2 ;;
  esac

  if ! valid_env_name "${env_name}"; then
    logger error "非法环境名: ${env_name} (仅允许字母/数字/下划线/连字符)"
    exit 2
  fi

  local env_dir="${INVENTORY_DIR}/${env_name}"
  if [ ! -d "${env_dir}" ]; then
    logger error "环境 ${env_name} 不存在, 请先执行: ./rke2ctl new ${env_name}"
    exit 2
  fi
  [ -f "${env_dir}/hosts" ] || { logger error "缺少 ${env_dir}/hosts, 请先修改 hosts"; exit 1; }

  if [ "${node_type}" = "ssh-copy" ]; then
    cmd_ssh_copy "${env_dir}"
    exit $?
  fi

  [ -f "${env_dir}/secrets.yml" ] || { logger error "缺少 ${env_dir}/secrets.yml, 请先加密并填入 sudo 密码"; exit 1; }

  command -v ansible-playbook >/dev/null 2>&1 || {
    logger error "未找到 ansible-playbook, 请先安装 ansible"
    exit 1
  }

  logger info "开始部署: ${env_name} (${node_type})"
  logger info "执行: ansible-playbook -i inventory/${env_name}/hosts --ask-vault-pass -e env_dir=${env_dir} playbooks/${node_type}.yml"

  ansible-playbook -i "inventory/${env_name}/hosts" \
                   --ask-vault-pass -e "env_dir=${env_dir}" "playbooks/${node_type}.yml"
  local rc=$?
  if [ "${rc}" -eq 0 ]; then
    logger info "部署完成 (退出码 0)"
  else
    logger error "部署失败 (退出码 ${rc}: 1=执行错误 2=主机不可达 3=解析错误 99=中断)"
  fi
  exit "${rc}"
}

cmd_ssh_copy() {
  local env_dir="$1"
  local hosts_file="${env_dir}/hosts"
  local site_file="${env_dir}/site.yml"

  command -v sshpass >/dev/null 2>&1 || {
    logger error "未找到 sshpass, 请先安装 (如: yum install -y sshpass)"
    exit 1
  }

  local ssh_user
  ssh_user="$(sed -n 's/^ssh_user:[[:space:]]*\([^ #]*\).*/\1/p' "${site_file}" | head -1)"
  [ -z "${ssh_user}" ] && ssh_user="admin"

  local master_ips=() worker_ips=() master_hosts=() worker_hosts=() group host ip
  while read -r group host ip; do
    case "${group}" in
      M) master_ips+=("${ip}"); master_hosts+=("${host}") ;;
      W) worker_ips+=("${ip}"); worker_hosts+=("${host}") ;;
    esac
  done < <(awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*\[/ { s = ($0 ~ /rke2_server/) ? "M" : (($0 ~ /rke2_agent/) ? "W" : ""); next }
    s != "" && match($0, /ansible_host=[0-9.]+/) {
      ip = substr($0, RSTART + 13, RLENGTH - 13)
      if (!seen[s, ip]++) { print s, $1, ip }
    }
  ' "${hosts_file}")

  local total=$(( ${#master_ips[@]} + ${#worker_ips[@]} ))
  if [ "${total}" -eq 0 ]; then
    logger error "未在 ${hosts_file} 中解析到任何主机"
    exit 1
  fi
  logger info "SSH 用户: ${ssh_user}"
  if [ "${#master_ips[@]}" -gt 0 ]; then
    logger info "向 ${#master_ips[@]} 台 master 主机分发公钥: "
    for ip in "${master_ips[@]}"; do
      echo "${ip} "
    done
  fi
  if [ "${#worker_ips[@]}" -gt 0 ]; then
    logger info "向 ${#worker_ips[@]} 台 worker 主机分发公钥: "
    for ip in "${worker_ips[@]}"; do
      echo "${ip} "
    done
  fi

  if [ ! -f ~/.ssh/id_rsa.pub ]; then
    logger info "未检测到 SSH 公钥, 自动生成..."
    ssh-keygen -t rsa -b 4096 -N "" -f ~/.ssh/id_rsa || { logger error "SSH 密钥生成失败"; exit 1; }
  fi
  chmod 600 ~/.ssh/id_rsa 2>/dev/null
  chmod 644 ~/.ssh/id_rsa.pub 2>/dev/null

  # 从 secrets.yml 读取各主机 admin 密码 (servers.<主机名>.sudopass, base64 编码)
  local secrets_file="${env_dir}/secrets.yml"
  if [ ! -f "${secrets_file}" ]; then
    logger error "缺少 ${secrets_file}, 请先创建并加密 (参考 inventory/sample/secrets.yml)"
    exit 1
  fi
  command -v ansible-vault >/dev/null 2>&1 || {
    logger error "未找到 ansible-vault, 请先安装 ansible"
    exit 1
  }
  logger info "正在解密 ${secrets_file} (请输入 vault 密码)"
  local vault_text
  vault_text="$(ansible-vault view "${secrets_file}" 2>/dev/null)" || {
    logger error "secrets.yml 解密失败, 请检查 vault 密码"
    exit 1
  }

  # 解析 servers.<主机名>.sudopass (base64) → host_pass_b64[主机名]
  local -A host_pass_b64=()
  local cur_host="" line
  local re_host="^[[:space:]]{2}[A-Za-z0-9_.-]+:[[:space:]]*$"
  local re_sudopass="^[[:space:]]{4}sudopass:[[:space:]]*[\"']?([^\"'[:space:]]+)[\"']?"
  while IFS= read -r line; do
    if [[ "${line}" =~ ${re_host} ]]; then
      cur_host="${line//[[:space:]]/}"
      cur_host="${cur_host%:}"
    elif [[ -n "${cur_host}" && "${line}" =~ ${re_sudopass} ]]; then
      host_pass_b64["${cur_host}"]="${BASH_REMATCH[1]}"
    fi
  done <<< "${vault_text}"

  local rc=0 ip ip_pad
  local -a group_ips group_hosts
  for group in master worker; do
    if [ "${group}" = "master" ]; then
      group_ips=("${master_ips[@]}")
      group_hosts=("${master_hosts[@]}")
    else
      group_ips=("${worker_ips[@]}")
      group_hosts=("${worker_hosts[@]}")
    fi
    for i in "${!group_ips[@]}"; do
      ip="${group_ips[i]}"
      local host="${group_hosts[i]}"
      local b64="${host_pass_b64[${host}]}"
      if [ -z "${b64}" ]; then
        logger error "secrets.yml 中缺少主机 ${host} 的 sudopass"
        rc=1
        continue
      fi
      local password
      password="$(printf '%s' "${b64}" | base64 -d)"
      printf -v ip_pad '%-15s' "${ip}"
      sshpass -p "${password}" ssh-copy-id \
          -o StrictHostKeyChecking=accept-new \
          -o ConnectTimeout=10 \
          -o ServerAliveInterval=5 \
          -o ServerAliveCountMax=3 \
          -o PasswordAuthentication=yes \
          "${ssh_user}@${ip}" >/dev/null 2>&1
      if [ $? -eq 0 ]; then
        logger info "分发到 ${group}：${host} ${ip_pad} 分发成功"
      else
        logger error "分发到 ${group}：${host} ${ip_pad} 分发失败"
        rc=1
      fi
    done
  done
  unset password
  [ "${rc}" -eq 0 ] && logger info "全部主机分发完成" || logger error "存在分发失败的主机 (退出码 ${rc})"
  exit "${rc}"
}

cmd_install_completion() {
  local bashrc="${HOME}/.bashrc"
  local comp_file="${HOME}/.rke2ctl.bash"

  local func_body
  func_body="$(cat <<'FUNC'
# rke2ctl tab 补全 (独立补全文件, 由 ~/.bashrc 加载)
_rke2ctl() {
  local cur envs name
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"

  # 第 1 个参数: 顶层命令
  if [ "${COMP_CWORD}" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "new setup download help bash-completion" -- "${cur}") )
    return 0
  fi

  case "${COMP_WORDS[1]}" in
    new)
      # new <环境名>: 创建新环境, 不做补全
      ;;
    download)
      if [ "${COMP_CWORD}" -eq 2 ]; then
        # 第 2 参数: 环境名
        envs=""
        for d in "__RKE2_REPO_ROOT__"/inventory/*/; do
          [ -d "${d}" ] || continue
          name="$(basename "${d}")"
          [ "${name}" = "sample" ] && continue
          envs="${envs} ${name}"
        done
        COMPREPLY=( $(compgen -W "${envs}" -- "${cur}") )
      fi
      ;;
    setup)
      if [ "${COMP_CWORD}" -eq 2 ]; then
        # 环境名: inventory 下所有目录, 排除 sample 模板
        envs=""
        for d in "__RKE2_REPO_ROOT__"/inventory/*/; do
          [ -d "${d}" ] || continue
          name="$(basename "${d}")"
          [ "${name}" = "sample" ] && continue
          envs="${envs} ${name}"
        done
        COMPREPLY=( $(compgen -W "${envs}" -- "${cur}") )
      elif [ "${COMP_CWORD}" -eq 3 ]; then
        # 部署类型
        COMPREPLY=( $(compgen -W "rke2-server rke2-agent ssh-copy" -- "${cur}") )
      fi
      ;;
  esac
}
complete -F _rke2ctl ./rke2ctl rke2ctl
FUNC
)"
  func_body="${func_body//__RKE2_REPO_ROOT__/${REPO_ROOT}}"

  printf '%s\n' "${func_body}" > "${comp_file}" || { logger error "写入 ${comp_file} 失败"; exit 1; }
  logger info "Tab 补全脚本已写入   ${comp_file}"

  if [ -f "${bashrc}" ]; then
    grep -vF ".rke2ctl.bash" "${bashrc}" \
      | grep -vF "rke2ctl_completion.sh" \
      | grep -vF "complete -F _rke2ctl" \
      | grep -vF "# rke2ctl tab 补全" \
      | awk 'NF==0 && wasblank { next } { wasblank=(NF==0); print }' \
      > "${bashrc}.new"
    sed -i ':a; /^\n*$/{ $d; N; ba }' "${bashrc}.new"
    mv "${bashrc}.new" "${bashrc}"
  fi

  printf '\n# rke2ctl tab 补全 (bash-completion)\nsource ~/.rke2ctl.bash\n' >> "${bashrc}" \
    || { logger error "写入 ${bashrc} 失败"; exit 1; }
  logger info "已写入 ${bashrc}"
  echo " "
}

cmd_download() {
  # 参数: 环境名; rke2_version/arch/cni 均取自该环境 site.yml
  [ "$#" -eq 1 ] || {
    logger error "download 需要 1 个参数: 环境名"
    usage >&2; exit 2
  }
  local env_name="$1"
  local version arch_cfg cni
  local arch_linux arch_short version_urlsafe dest_dir site_file

  if ! valid_env_name "${env_name}"; then
    logger error "非法环境名: ${env_name} (仅允许字母/数字/下划线/连字符)"
    exit 2
  fi
  site_file="${INVENTORY_DIR}/${env_name}/site.yml"
  [ -f "${site_file}" ] || {
    logger error "找不到 ${site_file}, 请先 ./rke2ctl new ${env_name} 或指定已有环境名"
    exit 1
  }

  # 解析顶层 rke2_version / arch 与 rke2_server.cni (兼容带引号与注释)
  version="$(sed -n 's/^rke2_version:[[:space:]]*["'\'']\{0,1\}\([^"'\''[:space:]]*\).*/\1/p' "${site_file}" | head -1)"
  arch_cfg="$(sed -n 's/^arch:[[:space:]]*["'\'']\{0,1\}\([^"'\''[:space:]]*\).*/\1/p' "${site_file}" \
              | head -1 | tr 'A-Z' 'a-z')"
  # GitHub 加速镜像: 读环境 site.yml 的 download_proxy (空格分隔多个, 依次尝试), 留空则直连
  download_proxy="$(sed -n 's/^download_proxy:[[:space:]]*["'\'']\{0,1\}\([^"'\'']*\).*/\1/p' "${site_file}" \
                    | head -1 | sed 's/[[:space:]]*##.*//')"
  cni="$(sed -n 's/^[[:space:]]*cni:[[:space:]]*["'\'']\{0,1\}\([^"'\''[:space:]]*\).*/\1/p' "${site_file}" \
         | head -1 | tr 'A-Z' 'a-z')"
  logger info "环境 ${env_name} 配置: rke2_version=${version:-空} arch=${arch_cfg:-空} cni=${cni:-none}"

  # 版本格式校验 (如 v1.34.6+rke2r3, 兼容 hotfix 后缀)
  if ! [[ "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+\+rke2r[0-9]+(\.[0-9a-zA-Z]+)*$ ]]; then
    logger error "site.yml 中缺少合法的 rke2_version: ${version:-空} (示例: v1.34.6+rke2r3)"
    exit 2
  fi
  version_urlsafe="${version//+/%2B}"   # GitHub URL 中 + 必须编码为 %2B

  # 架构映射 (amd/arm 简写 -> amd64/arm64)
  case "${arch_cfg}" in
    amd|amd64) arch_linux="linux-amd64"; arch_short="amd64" ;;
    arm|arm64) arch_linux="linux-arm64"; arch_short="arm64" ;;
    *) logger error "site.yml 中 arch 配置非法: ${arch_cfg:-空} (可选: amd/amd64/arm/arm64)"; exit 2 ;;
  esac

  # 目标目录 packages_rke2/<环境名>/<版本>/<架构>/ (架构目录用规范形式: amd64/arm64)
  dest_dir="${REPO_ROOT}/packages_rke2/${env_name}/${version}/${arch_short}"
  mkdir -p "${dest_dir}" || { logger error "创建目录失败: ${dest_dir}"; exit 1; }

  # 必下文件清单
  local -a files=(
    "install.sh"
    "rancher-load-images.sh"
    "rke2.${arch_linux}.tar.gz"
    "sha256sum-${arch_short}.txt"
    "rke2-images-all.${arch_linux}.txt"
    "rke2-images.${arch_linux}.tar.gz"
  )
  # 按 cni 值追加对应的 CNI 镜像包 (.tar.gz + .txt)
  case "${cni}" in
    *cilium*) files+=("rke2-images-cilium.${arch_linux}.tar.gz" "rke2-images-cilium.${arch_linux}.txt") ;;
    *canal*)  files+=("rke2-images-canal.${arch_linux}.tar.gz"  "rke2-images-canal.${arch_linux}.txt")  ;;
    *calico*) files+=("rke2-images-calico.${arch_linux}.tar.gz" "rke2-images-calico.${arch_linux}.txt") ;;
  esac

  # 下载阶段 (已存在且非空则跳过, 完整性由校验阶段兜底)
  # GitHub 加速镜像: 空格分隔为列表, 依次尝试直至成功
  local -a gh_mirrors=()
  read -r -a gh_mirrors <<< "${download_proxy}"
  local file url gh_path ok
  local -a urls
  for file in "${files[@]}"; do
    gh_path=""   # 非空表示该文件来自 GitHub, 需走加速镜像
    case "${file}" in
      install.sh)
        url="https://get.rke2.io" ;;
      rancher-load-images.sh)
        gh_path="rancher/rancher/releases/download/v2.15.0/rancher-load-images.sh" ;;
      *)
        gh_path="rancher/rke2/releases/download/${version_urlsafe}/${file}" ;;
    esac

    if [ -s "${dest_dir}/${file}" ]; then
      logger info "已存在, 跳过下载: ${file}"
      continue
    fi

    # 候选下载地址: GitHub 文件先依次走加速镜像, 最后兜底官方直连
    urls=()
    if [ -n "${gh_path}" ]; then
      for mirror in "${gh_mirrors[@]}"; do
        urls+=("${mirror}https://github.com/${gh_path}")
      done
      urls+=("https://github.com/${gh_path}")
    else
      urls+=("${url}")
    fi

    ok=0
    for u in "${urls[@]}"; do
      logger info "正在下载: ${file} <- ${u}"
      if curl -fL --connect-timeout 10 --retry 2 --retry-delay 2 --retry-all-errors \
           -o "${dest_dir}/${file}" "${u}"; then
        ok=1
        break
      fi
      rm -f "${dest_dir}/${file}"   # 删除残file, 保证下次重下完整
    done
    if [ "${ok}" -ne 1 ]; then
      logger error "下载失败: ${file} (全部加速镜像及官方直连均失败)"
      exit 1
    fi
  done

  # 校验阶段 (sha256sum 文件条目格式: "hash  文件名" 双空格)
  local checksums="${dest_dir}/sha256sum-${arch_short}.txt"
  [ -f "${checksums}" ] || { logger error "缺少校验文件 ${checksums}"; exit 1; }
  local expected actual fail=0
  for file in "${files[@]}"; do
    expected="$(grep -F "  ${file}" "${checksums}" | head -1 | awk '{print $1}')"
    if [ -z "${expected}" ]; then
      # install.sh / rancher-load-images.sh / sha256sum 自身无校验条目, 仅做非空检查
      if [ -s "${dest_dir}/${file}" ]; then
        logger info "非空检查通过: ${file}"
      else
        logger error "文件缺失或为空: ${file}"
        fail=1
      fi
      continue
    fi
    actual="$(sha256sum "${dest_dir}/${file}" | awk '{print $1}')"
    if [ "${actual}" = "${expected}" ]; then
      logger info "校验通过: ${file}"
    else
      logger error "校验失败: ${file} (期望 ${expected}, 实际 ${actual})"
      logger error "请删除后重下: rm -f '${dest_dir}/${file}'"
      fail=1
    fi
  done

  if [ "${fail}" -eq 0 ]; then
    logger info "全部下载完成并校验通过: ${dest_dir}"
  else
    logger error "存在失败项, 修复后重跑: ./rke2ctl download ${env_name}"
    exit 1
  fi
}

main() {
  local cmd="${1:-}"
  [[ -n "${cmd}" ]] || { logger warn "缺少命令, 可参考以下步骤:"; usage; exit 0; }
  case "${cmd}" in
    new)          shift; cmd_new "$@" ;;
    setup)        shift; cmd_setup "$@" ;;
    d|download)   shift; cmd_download "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    bash-completion) shift; cmd_install_completion "$@" ;;
    *)            usage; exit 0 ;;
  esac
}
main "$@"
exec bash
